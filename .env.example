# Copy to .env for local use. Never commit real values.
APP_PORT=3000
APP_DIST_DIR=dist

# OpenAI-compatible text endpoint. Use APP_TEXT_PROTOCOL=bedrock only when the
# configured endpoint implements the Bedrock-compatible adapter in server.go.
APP_TEXT_BASE_URL=https://api.example.com
APP_TEXT_API_KEY=replace-with-your-key
APP_TEXT_MODEL=replace-with-your-model
APP_TEXT_PROTOCOL=openai

# OpenAI-compatible image endpoint. Set APP_IMAGE_PROTOCOL=google only for a
# Google GenerateContent-compatible gateway.
APP_IMAGE_BASE_URL=https://api.example.com
APP_IMAGE_API_KEY=replace-with-your-key
APP_IMAGE_MODEL=replace-with-your-image-model
APP_IMAGE_PROTOCOL=openai

# Optional speech and video providers.
APP_MIMO_BASE_URL=https://api.example.com/v1
APP_MIMO_API_KEY=replace-with-your-key
APP_SEEDANCE_BASE_URL=https://api.example.com
APP_SEEDANCE_API_KEY=replace-with-your-key
APP_SEEDANCE_MODEL=replace-with-your-video-model
APP_SEEDANCE_CREATE_PATH=/v1/videos
APP_SEEDANCE_STATUS_PATH=/v1/videos/{id}
